# Supabase Configuration (Local Development)
# For local development, use: http://localhost:54321
# For production, get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-placeholder-key
SUPABASE_SERVICE_ROLE_KEY=your-placeholder-key

# LLM API Keys (Store in Supabase Vault via Settings page)
# These are managed through the dashboard, not environment variables
XAI_API_KEY=your-xai-api-key
# - ANTHROPIC_API_KEY
# - GOOGLE_AI_API_KEY
# - OPENAI_API_KEY

# Local-First Architecture Configuration
# Node.js Runtime for local development (embedded worker replaces hosted edge functions)
NEXT_RUNTIME=nodejs

# Ollama Configuration for local LLM inference
# Start Ollama locally with: ollama serve
OLLAMA_BASE_URL=http://localhost:11434/v1

# Worker Configuration for embedded task processing
# Poll interval in milliseconds for queue processing
WORKER_QUEUE_POLL_INTERVAL=2000

# Slack Socket Mode (replaces webhook-based integration)
# Enable Socket Mode for local development and reliable event delivery
SLACK_SOCKET_MODE_ENABLED=true

# Slack Integration (Store in Supabase Vault via Channels page)
# Global defaults — per-agent overrides configured in Channels > Slack Bots
# - SLACK_BOT_TOKEN          (xoxb-... from Slack app OAuth)
# - SLACK_SIGNING_SECRET     (from Slack app Basic Information)
# Per-agent (auto-generated names):
# - SLACK_BOT_TOKEN_{AGENT_SLUG}
# - SLACK_SIGNING_SECRET_{AGENT_SLUG}
